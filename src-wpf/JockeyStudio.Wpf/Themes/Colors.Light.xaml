<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light appearance. Same keys as Colors.xaml so the palette dictionaries are
       interchangeable at runtime (ThemeManager swaps them); only the surface /
       text / border / hover families differ from the dark theme. -->

  <!-- Core palette -->
  <Color x:Key="BgColor">#F4F5F7</Color>
  <Color x:Key="PanelColor">#FFFFFF</Color>
  <Color x:Key="Panel2Color">#F6F7FA</Color>
  <Color x:Key="Panel3Color">#EAEDF2</Color>
  <Color x:Key="BorderColor">#D5DAE2</Color>
  <Color x:Key="TextColor">#1C2129</Color>
  <Color x:Key="TextDimColor">#5E6675</Color>
  <Color x:Key="AccentColor">#4F8CFF</Color>
  <Color x:Key="Accent2Color">#7C6BFF</Color>
  <Color x:Key="DangerColor">#FF5C6C</Color>
  <Color x:Key="OkColor">#3ECF8E</Color>
  <Color x:Key="WarnColor">#F2B134</Color>

  <!-- Hover / state colors -->
  <Color x:Key="HoverColor">#E3E7EE</Color>
  <Color x:Key="HoverBorderColor">#C7CFDA</Color>
  <Color x:Key="AccentHoverColor">#3B76E0</Color>
  <Color x:Key="DangerStrongColor">#E04555</Color>

  <!-- Translucent brushes (rgba equivalents, AARRGGBB) -->
  <Color x:Key="AccentA10Color">#1A4F8CFF</Color>
  <Color x:Key="OkA14Color">#243ECF8E</Color>
  <Color x:Key="WarnA12Color">#1FF2B134</Color>
  <Color x:Key="WarnBorder25Color">#40F2B134</Color>
  <Color x:Key="DangerA12Color">#1FFF5C6C</Color>
  <Color x:Key="DangerA08Color">#14FF5C6C</Color>
  <Color x:Key="DangerBorder25Color">#40FF5C6C</Color>
  <Color x:Key="AccentGlowColor">#8C4F8CFF</Color>
  <Color x:Key="OkGlowColor">#4D3ECF8E</Color>
  <Color x:Key="TrackColor">#FFB9C2CE</Color>
  <Color x:Key="TipBgColor">#F2FFFFFF</Color>
  <Color x:Key="TipBorderColor">#2E000000</Color>
  <Color x:Key="VeilColor">#80000000</Color>
  <Color x:Key="DropSlotBgColor">#0F3ECF8E</Color>
  <Color x:Key="ShadowColor">#80000000</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}"/>
  <SolidColorBrush x:Key="Panel3Brush" Color="{StaticResource Panel3Color}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource HoverBorderColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="DangerStrongBrush" Color="{StaticResource DangerStrongColor}"/>
  <SolidColorBrush x:Key="AccentA10Brush" Color="{StaticResource AccentA10Color}"/>
  <SolidColorBrush x:Key="OkA14Brush" Color="{StaticResource OkA14Color}"/>
  <SolidColorBrush x:Key="WarnA12Brush" Color="{StaticResource WarnA12Color}"/>
  <SolidColorBrush x:Key="WarnBorder25Brush" Color="{StaticResource WarnBorder25Color}"/>
  <SolidColorBrush x:Key="DangerA12Brush" Color="{StaticResource DangerA12Color}"/>
  <SolidColorBrush x:Key="DangerA08Brush" Color="{StaticResource DangerA08Color}"/>
  <SolidColorBrush x:Key="DangerBorder25Brush" Color="{StaticResource DangerBorder25Color}"/>
  <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}"/>
  <SolidColorBrush x:Key="OkGlowBrush" Color="{StaticResource OkGlowColor}"/>
  <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}"/>
  <SolidColorBrush x:Key="TipBgBrush" Color="{StaticResource TipBgColor}"/>
  <SolidColorBrush x:Key="TipBorderBrush" Color="{StaticResource TipBorderColor}"/>
  <SolidColorBrush x:Key="VeilBrush" Color="{StaticResource VeilColor}"/>
  <SolidColorBrush x:Key="DropSlotBgBrush" Color="{StaticResource DropSlotBgColor}"/>
  <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}"/>
  <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

  <!-- Brand dot gradient (linear-gradient(135deg, accent, accent-2)) -->
  <LinearGradientBrush x:Key="BrandDotBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
    <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
  </LinearGradientBrush>

  <!-- Font palette (Segoe UI per app.css) -->
  <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>