<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icon templates converted 1:1 from ui/src/components/icons.tsx (24x24 stroke SVGs).
    Use via a ContentControl:  <ContentControl Width="18" Height="18" Content=""
                                        ContentTemplate="{StaticResource IconPlay}"
                                        Foreground="..."/>
    Stroke color follows the foreground of the nearest ContentControl.
  -->

  <!-- Play: <polygon points="6 4 20 12 6 20 6 4"/> -->
  <DataTemplate x:Key="IconPlay">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M6,4 L20,12 L6,20 Z"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Pause: two rounded rects (6,4,4,16) and (14,4,4,16) rx=1 -->
  <DataTemplate x:Key="IconPause">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M6,5 A1,1 0 0 1 7,4 L9,4 A1,1 0 0 1 10,5 L10,19 A1,1 0 0 1 9,20 L7,20 A1,1 0 0 1 6,19 Z
                     M14,5 A1,1 0 0 1 15,4 L17,4 A1,1 0 0 1 18,5 L18,19 A1,1 0 0 1 17,20 L15,20 A1,1 0 0 1 14,19 Z"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Repeat / loop -->
  <DataTemplate x:Key="IconRepeat">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M17,1 L21,5 L17,9"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M3,11 L3,9 A4,4 0 0 1 7,5 L21,5"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M7,23 L3,19 L7,15"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M21,13 L21,15 A4,4 0 0 1 17,19 L3,19"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Volume -->
  <DataTemplate x:Key="IconVolume">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M11,5 L6,9 L2,9 L2,15 L6,15 L11,19 Z"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M15.54,8.46 A5,5 0 0 1 15.54,15.54"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M19.07,4.93 A10,10 0 0 1 19.07,19.07"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Volume mute -->
  <DataTemplate x:Key="IconVolumeMute">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M11,5 L6,9 L2,9 L2,15 L6,15 L11,19 Z"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M23,9 L17,15 M17,9 L23,15"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Shuffle / auto-mix (source rotated -90deg around 12,12) -->
  <DataTemplate x:Key="IconShuffle">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M3,8 L3,3 L8,3"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M20,20 L3,3"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M16,3 L21,3 L21,8"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M15,9 L21,3"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M4,20 L9,15"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Output device -->
  <DataTemplate x:Key="IconOutput">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M3,18 L3,12 A9,9 0 0 1 21,12 L21,18"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M21,19 A2,2 0 0 1 19,21 L18,21 A2,2 0 0 1 16,19 L16,16 A2,2 0 0 1 18,14 L21,14 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M3,19 A2,2 0 0 0 5,21 L6,21 A2,2 0 0 0 8,19 L8,16 A2,2 0 0 0 6,14 L3,14 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Check -->
  <DataTemplate x:Key="IconCheck">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M20,6 L9,17 L4,12"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Close (x) button glyph: two crossing strokes, geometrically centered so
       the X is optically dead-center in its button (a text "x" rides the
       baseline and drifts low/left). -->
  <DataTemplate x:Key="IconClose">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M6,6 L18,18 M18,6 L6,18"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Add (plus): two center-crossing strokes, geometric center of the 24x24 grid. -->
  <DataTemplate x:Key="IconPlus">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M12,4.5 L12,19.5 M4.5,12 L19.5,12"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

  <!-- Library: stack of two rounded "tile" outlines with a music note (music
       library / playlist), matching the stroke style of the icon set. -->
  <DataTemplate x:Key="IconLibrary">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="M3,8 A2,2 0 0 1 5,6 L12,6 A2,2 0 0 1 14,8 L14,17 A2,2 0 0 1 12,19 L5,19 A2,2 0 0 1 3,17 Z"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M9,10 A2,2 0 0 1 11,8 L18,8 A2,2 0 0 1 20,10 L20,19 A2,2 0 0 1 18,21 L11,21 A2,2 0 0 1 9,19 Z"
              Fill="Transparent"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M17,10 L17,16 A2,2 0 0 1 15,16"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}"
              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent"/>
      </Grid>
    </Viewbox>
  </DataTemplate>

</ResourceDictionary>