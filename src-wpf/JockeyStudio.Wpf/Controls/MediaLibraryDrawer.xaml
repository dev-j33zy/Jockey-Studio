<UserControl x:Class="JockeyStudio.Wpf.Controls.MediaLibraryDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">

  <UserControl.Resources>
    <!-- media-row -->
    <Style x:Key="MediaRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource DrawerChrome}" HorizontalAlignment="Right">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="0" Direction="180" Opacity="0.4" Color="Black"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
              Padding="16,14" Background="{DynamicResource PanelBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="Media Library" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Style="{StaticResource TbCloseButton}"
                  ToolTip="Close" Click="CloseButton_Click">
            <ContentControl Width="14" Height="14" Content="" ContentTemplate="{StaticResource IconClose}"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </Grid>
      </Border>

      <!-- Media list -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <StackPanel x:Name="LibraryList"/>

          <!-- Empty state -->
          <StackPanel x:Name="LibraryEmpty" Visibility="Collapsed" Margin="12,24" HorizontalAlignment="Center">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Text="No media yet. Drag music from File Explorer onto any deck to add it."/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>