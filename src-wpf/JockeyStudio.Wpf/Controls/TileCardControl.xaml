<UserControl x:Class="JockeyStudio.Wpf.Controls.TileCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:JockeyStudio.Wpf.Controls"
             xmlns:helpers="clr-namespace:JockeyStudio.Wpf.Helpers"
             MinWidth="320" MinHeight="320">

  <!-- Clipboard commands the window routes to a specific deck, shared by the
       card's right-click menu and its own Ctrl+C/X/V when the card has focus -->
  <UserControl.CommandBindings>
    <CommandBinding Command="Copy" Executed="OnCopyCommand" CanExecute="OnCopyCanExecute"/>
    <CommandBinding Command="Cut" Executed="OnCutCommand" CanExecute="OnCutCanExecute"/>
    <CommandBinding Command="Paste" Executed="OnPasteCommand" CanExecute="OnPasteCanExecute"/>
  </UserControl.CommandBindings>

  <UserControl.Resources>
    <helpers:NotConverter x:Key="Not"/>
    <helpers:FormatTimeConverter x:Key="FmtTime"/>
    <helpers:FormatDurationConverter x:Key="FmtDuration"/>
    <helpers:RoundPercentToStringConverter x:Key="FmtPercent"/>

    <!-- Blinking status dot for loading/playing decks -->
    <DataTemplate x:Key="StatusDotPlaying">
      <Ellipse Width="8" Height="8" Fill="{StaticResource OkBrush}"/>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Command="Cut" Header="_Cut"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Command="Copy" Header="_Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <MenuItem Command="Paste" Header="_Paste"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
      </ContextMenu>
    </Grid.ContextMenu>

    <!-- ===================== Card ===================== -->
    <Border x:Name="CardBorder" MinHeight="320" CornerRadius="12" BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="Playing">
              <Setter Property="BorderBrush" Value="#B33ECF8E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="Error">
              <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (drag handle for tile reordering) -->
        <Border x:Name="HeaderDock" Grid.Row="0" Background="{DynamicResource Panel2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                CornerRadius="12,12,0,0" Padding="12,10"
                PreviewMouseLeftButtonDown="HeaderDock_MouseLeftButtonDown">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

<TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="14"
                   VerticalAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{Binding Title, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasMedia, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="False">
                      <Setter Property="Text" Value="Empty Deck"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                      <Setter Property="FontWeight" Value="Medium"/>
                      <Setter Property="Opacity" Value="0.45"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <local:TrackedText Grid.Column="1" Margin="8,0,0,0" FontSize="9" LetterSpacing="0.8"
                               Opacity="0.7" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}"
                               Text="{Binding MediaType, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}">
              <local:TrackedText.Style>
                <Style TargetType="local:TrackedText">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasMedia, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="False">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </local:TrackedText.Style>
            </local:TrackedText>

            <Button Grid.Column="2" Style="{StaticResource TbToolButton}" ToolTip="Remove deck"
                    Margin="8,0,0,0" Width="24" Height="24" Click="RemoveButton_Click">
              <ContentControl Width="14" Height="14" Content="" ContentTemplate="{StaticResource IconClose}"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </Grid>
        </Border>

        <!-- Body -->
        <StackPanel x:Name="CardBody" Grid.Row="1" Margin="16,16,16,8">
          <StackPanel HorizontalAlignment="Center" Margin="0,8,0,12">
            <Button x:Name="PlayBtn" Style="{StaticResource TbPlayButton}" Click="PlayBtn_Click">
              <Grid>
                <ContentControl x:Name="PlayIconShow" Width="30" Height="30" Content=""
                                ContentTemplate="{StaticResource IconPlay}" Foreground="{DynamicResource TextBrush}"/>
                <ContentControl x:Name="PauseIconShow" Width="30" Height="30" Content=""
                                ContentTemplate="{StaticResource IconPause}" Foreground="{StaticResource OkBrush}"
                                Visibility="Collapsed"/>
              </Grid>
            </Button>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <local:TrackedText FontSize="22" FontWeight="Light" FontFamily="Segoe UI"
                                 LetterSpacing="0.5" Tabular="True" Foreground="{DynamicResource TextBrush}"
                                 Text="{Binding PositionSecs, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Converter={StaticResource FmtTime}}"/>
              <local:TrackedText Margin="6,0,0,2" FontSize="14" FontFamily="Segoe UI"
                                 LetterSpacing="0.5" Tabular="True" Foreground="{DynamicResource TextDimBrush}"
                                 VerticalAlignment="Bottom"
                                 Text="{Binding DurationSecs, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Converter={StaticResource FmtDuration}, StringFormat='/ {0}'}"/>
            </StackPanel>
          </StackPanel>

          <Grid>
            <Slider x:Name="Seek" Style="{StaticResource FillSliderH}" Margin="0,10,0,6"
                    Minimum="0"
                    Maximum="{Binding DurationSecs, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}"
                    Value="{Binding PositionSecs, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Mode=TwoWay}"
                    IsEnabled="{Binding HasMedia, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}"/>
            <Border x:Name="SeekTip" Visibility="Collapsed"
                    Background="{DynamicResource TipBgBrush}" BorderBrush="{DynamicResource TipBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="9,3"
                    VerticalAlignment="Top" Height="20" Margin="0,9,0,0"
                    HorizontalAlignment="Left" IsHitTestVisible="False">
              <local:TrackedText x:Name="SeekTipText" FontSize="11" FontWeight="Medium"
                                 LetterSpacing="0.4" Tabular="True" Foreground="{DynamicResource TextBrush}"
                                 VerticalAlignment="Center"/>
            </Border>
          </Grid>

          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,0,2"
                     FontSize="11.5" FontWeight="Medium"
                     Foreground="{StaticResource DangerBrush}"
                     FontFamily="Segoe UI"
                     TextWrapping="Wrap" HorizontalAlignment="Center"
                     Text="{Binding Error, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}"/>
        </StackPanel>

        <!-- Footer -->
        <Border x:Name="CardFooter" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="LoopBtn" Grid.Column="0" Style="{StaticResource TbCtlIcon}" Margin="2,0" Click="LoopBtn_Click">
              <local:LoopBadgeControl Value="{Binding LoopMode, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, FallbackValue=off}"/>
            </Button>
            <Button x:Name="VolBtn" Grid.Column="1" Style="{StaticResource TbCtlIcon}" Margin="2,0" Click="VolBtn_Click">
              <Grid>
                <ContentControl x:Name="VolumeIconShow" Width="18" Height="18" Content=""
                                ContentTemplate="{StaticResource IconVolume}" Foreground="{DynamicResource TextDimBrush}"/>
                <ContentControl x:Name="VolumeMuteIconShow" Width="18" Height="18" Content=""
                                ContentTemplate="{StaticResource IconVolumeMute}" Foreground="{DynamicResource TextDimBrush}"
                                Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="AutoMixBtn" Grid.Column="2" Style="{StaticResource TbCtlIcon}" Margin="2,0" Click="AutoMixBtn_Click"
                    helpers:Ctl.IsEngaged="{Binding AutoMix, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}">
              <ContentControl Width="18" Height="18" Content="" ContentTemplate="{StaticResource IconShuffle}"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button x:Name="DevBtn" Grid.Column="3" Style="{StaticResource TbCtlIcon}" Margin="2,0" Click="DevBtn_Click">
              <ContentControl Width="18" Height="18" Content="" ContentTemplate="{StaticResource IconOutput}"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </Grid>
        </Border>

        <!-- Outside-click veil for the popups (covers header + body only so the
             footer's toggle buttons stay clickable to switch modals) -->
        <Rectangle x:Name="PopupVeil" Grid.Row="0" Grid.RowSpan="2"
                   Fill="Transparent" Visibility="Collapsed"
                   MouseDown="PopupVeil_MouseDown"/>
      </Grid>
    </Border>

    <!-- ===================== Volume popup ===================== -->
    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolBtn}" Placement="Top"
           VerticalOffset="-10" HorizontalOffset="-40" StaysOpen="True" AllowsTransparency="True">
      <Border Style="{StaticResource PopPanel}" Width="120">
        <Grid>
        <StackPanel HorizontalAlignment="Center">
          <Button x:Name="MuteBtn" Style="{StaticResource TbPopMute}" Width="30" Height="30"
                  Click="MuteBtn_Click" Margin="0,0,0,10">
            <Grid>
              <ContentControl x:Name="MuteIconNormal" Width="16" Height="16" Content=""
                              ContentTemplate="{StaticResource IconVolume}" Foreground="{DynamicResource TextDimBrush}"/>
              <ContentControl x:Name="MuteIconMuted" Width="16" Height="16" Content=""
                              ContentTemplate="{StaticResource IconVolumeMute}" Foreground="{StaticResource WarnBrush}"
                              Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Slider x:Name="VolumeSlider" Style="{StaticResource FillSliderV}" Width="26" Height="130"
                  HorizontalAlignment="Center"
                  Minimum="0" Maximum="1"
                  Value="{Binding EffectiveVolume, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Mode=TwoWay}"/>
          <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,0"
                     Typography.NumeralAlignment="Tabular"
                     HorizontalAlignment="Center"
                     Text="{Binding EffectiveVolume, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Converter={StaticResource FmtPercent}}"/>
          <TextBlock x:Name="DuckHint" FontSize="10.5" FontWeight="Medium" Margin="0,3,0,0"
                     Foreground="{StaticResource WarnBrush}"
                     Typography.NumeralAlignment="Tabular"
                     HorizontalAlignment="Center"
                     Text="{Binding Volume, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Converter={StaticResource FmtPercent}, StringFormat='Ducked Â· base {0}%'}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding AutoMixDucked, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="True"/>
                      <Condition Binding="{Binding AutoMixPaused, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="PausedHint" FontSize="10.5" FontWeight="Medium" Margin="0,3,0,0"
                     Foreground="{StaticResource WarnBrush}"
                     Typography.NumeralAlignment="Tabular"
                     HorizontalAlignment="Center"
                     Text="{Binding Volume, RelativeSource={RelativeSource AncestorType=local:TileCardControl}, Converter={StaticResource FmtPercent}, StringFormat='Auto-paused Â· base {0}%'}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding AutoMixPaused, RelativeSource={RelativeSource AncestorType=local:TileCardControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        </Grid>
      </Border>
    </Popup>

    <!-- ===================== Device popup ===================== -->
    <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DevBtn}" Placement="Top"
           VerticalOffset="-10" HorizontalOffset="-268" StaysOpen="True" AllowsTransparency="True">
      <Border Style="{StaticResource PopPanel}" Width="308">
        <StackPanel>
          <local:TrackedText FontSize="11" Foreground="{DynamicResource TextDimBrush}" LetterSpacing="0.6"
                             Text="OUTPUT DEVICE" HorizontalAlignment="Left" Margin="2,0,0,8"/>
          <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DevListPanel" MaxHeight="320"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- ===================== Loop popup ===================== -->
    <Popup x:Name="LoopPopup" PlacementTarget="{Binding ElementName=LoopBtn}" Placement="Top"
           VerticalOffset="-10" HorizontalOffset="0" StaysOpen="True" AllowsTransparency="True">
      <Border Style="{StaticResource PopPanel}" Width="150">
        <StackPanel>
          <local:TrackedText FontSize="11" Foreground="{DynamicResource TextDimBrush}" LetterSpacing="0.6"
                             Text="LOOP REPEATS" HorizontalAlignment="Left" Margin="2,0,0,8"/>
          <ScrollViewer x:Name="LoopList" MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxHeight="320">
            <Button x:Name="LoopOffItem" Style="{StaticResource TbDevItem}" Click="LoopItem_Click"
                    Tag="off" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Text="Off" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="14" Height="14" Content="" Visibility="Collapsed"
                                ContentTemplate="{StaticResource IconCheck}" Foreground="{StaticResource AccentBrush}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (helpers:Ctl.IsActive), RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Button>
            <Button x:Name="LoopEndlessItem" Style="{StaticResource TbDevItem}" Click="LoopItem_Click"
                    Tag="endless" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Text="Endless" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="14" Height="14" Content="" Visibility="Collapsed"
                                ContentTemplate="{StaticResource IconCheck}" Foreground="{StaticResource AccentBrush}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (helpers:Ctl.IsActive), RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Button>
            <Button x:Name="Loop2Item" Style="{StaticResource TbDevItem}" Click="LoopItem_Click"
                    Tag="x2" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Text="2&#215;" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="14" Height="14" Content="" Visibility="Collapsed"
                                ContentTemplate="{StaticResource IconCheck}" Foreground="{StaticResource AccentBrush}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (helpers:Ctl.IsActive), RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Button>
            <Button x:Name="Loop3Item" Style="{StaticResource TbDevItem}" Click="LoopItem_Click"
                    Tag="x3" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Text="3&#215;" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="14" Height="14" Content="" Visibility="Collapsed"
                                ContentTemplate="{StaticResource IconCheck}" Foreground="{StaticResource AccentBrush}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (helpers:Ctl.IsActive), RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Button>
            <Button x:Name="Loop4Item" Style="{StaticResource TbDevItem}" Click="LoopItem_Click"
                    Tag="x4" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Text="4&#215;" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="14" Height="14" Content="" Visibility="Collapsed"
                                ContentTemplate="{StaticResource IconCheck}" Foreground="{StaticResource AccentBrush}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (helpers:Ctl.IsActive), RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Button>
            <Button x:Name="Loop5Item" Style="{StaticResource TbDevItem}" Click="LoopItem_Click"
                    Tag="x5" HorizontalContentAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" Text="5&#215;" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <ContentControl Grid.Column="1" Width="14" Height="14" Content="" Visibility="Collapsed"
                                ContentTemplate="{StaticResource IconCheck}" Foreground="{StaticResource AccentBrush}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding (helpers:Ctl.IsActive), RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </Grid>
            </Button>
          </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>