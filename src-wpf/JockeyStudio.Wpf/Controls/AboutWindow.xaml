<Window x:Class="JockeyStudio.Wpf.Controls.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Jockey Studio"
        Icon="/Assets/app.ico"
        Width="520" Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14">

  <!-- Native OS title bar (Jockey Studio's main window forces dark chrome via
       DWM; this window leaves the title bar to the OS so it adopts the system
       light/dark theme, and keeps only its OS close button). Below it: the
       brand title row, then the shared tab strip with the active tab merging
       into the page container. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Window header: brand title row (the OS title bar above provides the
         exit â€” no redundant close button here). -->
    <Border Grid.Row="0" Background="{DynamicResource Panel2Brush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="Jockey Studio" VerticalAlignment="Center"/>
    </Border>

    <!-- Tab strip (chrome). No bottom padding: the active tab merges
         directly into the page container below. -->
    <Border Grid.Row="1" Background="{DynamicResource Panel2Brush}"
            Padding="12,8,12,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="TabAboutButton" Style="{StaticResource DialogTabButton}" Content="About"
                Tag="0" Margin="0,0,12,0" Click="Tab_Click"/>
        <Button x:Name="TabWhatNewButton" Style="{StaticResource DialogTabButton}" Content="What's New"
                Tag="1" Margin="0,0,12,0" Click="Tab_Click"/>
        <Button x:Name="TabUpdatesButton" Style="{StaticResource DialogTabButton}" Content="Updates"
                Tag="2" Margin="0,0,0,0" Click="Tab_Click"/>
      </StackPanel>
    </Border>

    <!-- Page content -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PageHost">

          <!-- ============ About ============ -->
          <StackPanel x:Name="AboutPanel">
            <Border Style="{StaticResource SettingBlock}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Image Source="/Assets/app-icon.png" Width="26" Height="26" Margin="0,0,10,0"
                         VerticalAlignment="Center"/>
                  <TextBlock FontSize="18" FontWeight="SemiBold" Text="Jockey Studio"/>
                  <TextBlock x:Name="AboutVersionText" Margin="10,2,0,0" FontSize="13"
                             Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                             Text="v0.2.0"/>
                </StackPanel>

                <TextBlock Text="A native multi-deck audio workstation for Windows. Load tracks onto decks, route each deck to its own output device, and control the mix as you go with per-deck volume, mute, fades, loop repeats and auto-mix ducking."
                           TextWrapping="Wrap" LineHeight="21"/>

                <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                           Text="Built with WPF · .NET 8 · NAudio"/>

                <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                           Text="Updates delivered through GitHub releases."/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ What's New ============ -->
          <StackPanel x:Name="WhatNewPanel" Visibility="Collapsed">
            <Border Style="{StaticResource SettingBlock}">
              <StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                           Text="What's new in this build"/>
                <TextBlock x:Name="LatestTitleText" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="LatestSummaryText" Margin="0,6,0,0"
                           TextWrapping="Wrap" LineHeight="21"/>
              </StackPanel>
            </Border>
            <ItemsControl x:Name="VersionFeed">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingBlock}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Version, StringFormat='v{0}'}"/>
                        <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource TextDimBrush}" Text="{Binding Date}"/>
                      </StackPanel>
                      <TextBlock Margin="0,4,0,6" Foreground="{DynamicResource TextDimBrush}" FontSize="13"
                                 TextWrapping="Wrap" Text="{Binding Title}"/>
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                              <TextBlock Text="• " Foreground="{StaticResource AccentBrush}"/>
                              <TextBlock TextWrapping="Wrap" LineHeight="20" Text="{Binding}"/>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- ============ Updates ============ -->
          <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
            <Border Style="{StaticResource SettingBlock}">
              <StackPanel>
                <Button x:Name="UpdateButton" Style="{StaticResource TbButton}"
                        Content="Check for Updates" HorizontalAlignment="Left"
                        Click="CheckForUpdates_Click"/>
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingValueText}"
                           Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
  </Grid>
</Window>