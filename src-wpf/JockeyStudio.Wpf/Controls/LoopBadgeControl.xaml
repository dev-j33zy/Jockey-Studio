<UserControl x:Class="JockeyStudio.Wpf.Controls.LoopBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="18" Height="18">
  <Grid>
    <ContentControl Width="18" Height="18" Content="" ContentTemplate="{StaticResource IconRepeat}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <TextBlock x:Name="BadgeText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="8" FontWeight="Bold"
               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
  </Grid>
</UserControl>