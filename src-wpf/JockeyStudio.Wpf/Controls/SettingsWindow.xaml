<Window x:Class="JockeyStudio.Wpf.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Engine Settings"
        Width="500" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14">

  <!-- Same chrome as the About window: native OS title bar (adopts the system
       light/dark theme, keeps its OS close button), the Engine Settings title
       row, then the shared tab strip with the active tab merging into the page
       container. Hosts every Engine Settings control; edits push back through
       SettingsChanged so changes apply to the live session â€” no save button. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Window header: brand title row (the OS title bar above provides the
         exit â€” no redundant close button here). -->
    <Border Grid.Row="0" Background="{DynamicResource Panel2Brush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <TextBlock FontSize="16" FontWeight="SemiBold" Text="Engine Settings" VerticalAlignment="Center"/>
    </Border>

    <!-- Tab strip (chrome). No bottom padding: the active tab merges
         directly into the page container below. -->
    <Border Grid.Row="1" Background="{DynamicResource Panel2Brush}"
            Padding="12,8,12,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="TabAutomixButton" Style="{StaticResource DialogTabButton}" Content="Auto-mix"
                Tag="0" Margin="0,0,12,0" Click="Tab_Click"/>
        <Button x:Name="TabPlaybackButton" Style="{StaticResource DialogTabButton}" Content="Playback"
                Tag="1" Margin="0,0,12,0" Click="Tab_Click"/>
        <Button x:Name="TabAudioButton" Style="{StaticResource DialogTabButton}" Content="Audio"
                Tag="2" Margin="0,0,0,0" Click="Tab_Click"/>
      </StackPanel>
    </Border>

    <!-- Page content -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- ============ Auto-mix ============ -->
        <StackPanel x:Name="AutomixPanel">
          <Border Style="{StaticResource SettingBlock}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto-mix duck (dB)"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SettingValueText}"
                           Text="{Binding Value, ElementName=AutoMixDbSlider, StringFormat='-{}{0:0} dB'}"/>
              </Grid>
              <Slider x:Name="AutoMixDbSlider" Style="{StaticResource FillSliderH}" Minimum="0" Maximum="40" Value="10"
                      IsMoveToPointEnabled="True" ValueChanged="SettingSlider_ValueChanged"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingBlock}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto-mix attack (s)"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SettingValueText}"
                           Text="{Binding Value, ElementName=AttackSlider, StringFormat='{}{0:0.00} s'}"/>
              </Grid>
              <Slider x:Name="AttackSlider" Style="{StaticResource FillSliderH}" Minimum="0.05" Maximum="1.5"
                      SmallChange="0.05" LargeChange="0.05" Value="0.25"
                      IsMoveToPointEnabled="True" ValueChanged="SettingSlider_ValueChanged"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingBlock}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto-mix release (s)"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SettingValueText}"
                           Text="{Binding Value, ElementName=ReleaseSlider, StringFormat='{}{0:0.00} s'}"/>
              </Grid>
              <Slider x:Name="ReleaseSlider" Style="{StaticResource FillSliderH}" Minimum="0.1" Maximum="3"
                      SmallChange="0.05" LargeChange="0.05" Value="0.80"
                      IsMoveToPointEnabled="True" ValueChanged="SettingSlider_ValueChanged"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============ Playback ============ -->
        <StackPanel x:Name="PlaybackPanel" Visibility="Collapsed">
          <Border Style="{StaticResource SettingBlock}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default fade-in (s)"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SettingValueText}"
                           Text="{Binding Value, ElementName=FadeInSlider, StringFormat='{}{0:0.00}'}"/>
              </Grid>
              <Slider x:Name="FadeInSlider" Style="{StaticResource FillSliderH}" Minimum="0" Maximum="3"
                      SmallChange="0.05" LargeChange="0.05" Value="0.05"
                      IsMoveToPointEnabled="True" ValueChanged="SettingSlider_ValueChanged"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingBlock}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default fade-out (s)"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SettingValueText}"
                           Text="{Binding Value, ElementName=FadeOutSlider, StringFormat='{}{0:0.00}'}"/>
              </Grid>
              <Slider x:Name="FadeOutSlider" Style="{StaticResource FillSliderH}" Minimum="0" Maximum="3"
                      SmallChange="0.05" LargeChange="0.05" Value="0.20"
                      IsMoveToPointEnabled="True" ValueChanged="SettingSlider_ValueChanged"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============ Audio ============ -->
        <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
          <Border Style="{StaticResource SettingBlock}">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default device output"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SettingValueText}" x:Name="DeviceValueText"
                           Text="System Default"/>
              </Grid>
              <ComboBox x:Name="DeviceCombo" Style="{StaticResource TbSelect}"
                        SelectionChanged="DeviceCombo_SelectionChanged"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingBlock}">
            <Button x:Name="RefreshDevicesButton" Style="{StaticResource TbButton}"
                    Content="Refresh Audio Devices" HorizontalAlignment="Left"
                    Click="RefreshDevices_Click"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>