<UserControl x:Class="JockeyStudio.Wpf.Controls.UpdateDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Background="{DynamicResource VeilBrush}" MouseLeftButtonDown="Veil_MouseLeftButtonDown">
    <!-- Dialog -->
    <Border Width="520" MaxWidth="600" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" MouseLeftButtonDown="Dialog_MouseLeftButtonDown">
      <Border.Effect>
        <DropShadowEffect BlurRadius="36" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Head -->
        <Border Grid.Row="0" Background="{DynamicResource Panel2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Update available" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource TbCloseButton}"
                    ToolTip="Close" Click="CloseButton_Click">
              <ContentControl Width="14" Height="14" Content="" ContentTemplate="{StaticResource IconClose}"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </Grid>
        </Border>

        <!-- Versions -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Margin="16,14">
            <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource TextDimBrush}"
                       Typography.NumeralAlignment="Tabular" Text="v0.2.0"/>
            <TextBlock Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Text="to"/>
            <TextBlock x:Name="LatestVersionText" Margin="10,0,0,0" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Typography.NumeralAlignment="Tabular" Text="v0.2.0"/>
          </StackPanel>
        </Border>

        <!-- Release notes -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="320">
          <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="13" LineHeight="21"
                     Padding="16,14" Text="Fixed a bug where the app could save playlists with a missing output device entry, and tightened cross-platform launcher handling on update."/>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="3" Background="{DynamicResource Panel2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,14">
          <StackPanel>
            <TextBlock x:Name="UpdateProgressNote" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,10"
                       Visibility="Collapsed"
                       Text="Downloading the installer and closing the app. It will relaunch automatically once installed."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="LaterButton" Style="{StaticResource TbButton}" Content="Update Later"
                      Click="LaterButton_Click"/>
              <Button x:Name="InstallButton" Style="{StaticResource TbPrimaryButton}" Content="Install Now"
                      Margin="10,0,0,0" Click="InstallButton_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>