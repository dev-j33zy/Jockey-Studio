<Window x:Class="JockeyStudio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JockeyStudio.Wpf.Controls"
        xmlns:local="clr-namespace:JockeyStudio.Wpf"
        Title="Jockey Studio"
        Icon="/Assets/app.ico"
        Width="1500" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14">

  <Window.CommandBindings>
    <CommandBinding Command="Open" Executed="MenuOpenFile_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="{x:Static local:MainWindow.OpenPlaylistCommand}" Executed="MenuOpenPlaylist_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="Save" Executed="MenuSave_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="SaveAs" Executed="MenuSaveAs_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="Undo" Executed="EditUndo_Executed" CanExecute="EditUndo_CanExecute"/>
    <CommandBinding Command="Redo" Executed="EditRedo_Executed" CanExecute="EditRedo_CanExecute"/>
    <CommandBinding Command="Cut" Executed="EditCut_Executed" CanExecute="EditClipboard_CanExecute"/>
    <CommandBinding Command="Copy" Executed="EditCopy_Executed" CanExecute="EditClipboard_CanExecute"/>
    <CommandBinding Command="Paste" Executed="EditPaste_Executed" CanExecute="EditPaste_CanExecute"/>
    <CommandBinding Command="Find" Executed="EditFind_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="{x:Static local:MainWindow.FullScreenCommand}" Executed="FullScreen_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="{x:Static local:MainWindow.OpenDocumentationCommand}" Executed="OpenDocumentation_Executed" CanExecute="MenuCommand_CanExecute"/>
    <CommandBinding Command="{x:Static NavigationCommands.IncreaseZoom}" Executed="WindowZoomIn_Executed" CanExecute="WindowZoomIn_CanExecute"/>
    <CommandBinding Command="{x:Static NavigationCommands.DecreaseZoom}" Executed="WindowZoomOut_Executed" CanExecute="WindowZoomOut_CanExecute"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="Open" Key="O" Modifiers="Control"/>
    <KeyBinding Command="{x:Static local:MainWindow.OpenPlaylistCommand}" Key="O" Modifiers="Control+Shift"/>
    <KeyBinding Command="Save" Key="S" Modifiers="Control"/>
    <KeyBinding Command="Undo" Key="Z" Modifiers="Control"/>
    <KeyBinding Command="Redo" Key="Y" Modifiers="Control"/>
    <KeyBinding Command="Redo" Key="Z" Modifiers="Control+Shift"/>
    <KeyBinding Command="Cut" Key="X" Modifiers="Control"/>
    <KeyBinding Command="Copy" Key="C" Modifiers="Control"/>
    <KeyBinding Command="Paste" Key="V" Modifiers="Control"/>
    <KeyBinding Command="Find" Key="F" Modifiers="Control"/>
    <KeyBinding Command="{x:Static local:MainWindow.FullScreenCommand}" Key="F11"/>
    <KeyBinding Command="{x:Static NavigationCommands.IncreaseZoom}" Key="OemPlus" Modifiers="Control"/>
    <KeyBinding Command="{x:Static NavigationCommands.IncreaseZoom}" Key="Add" Modifiers="Control"/>
    <KeyBinding Command="{x:Static NavigationCommands.DecreaseZoom}" Key="OemMinus" Modifiers="Control"/>
    <KeyBinding Command="{x:Static NavigationCommands.DecreaseZoom}" Key="Subtract" Modifiers="Control"/>
  </Window.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Menu bar with the deck search field docked on the right end (the deck
         finder filters the grid as you type). -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Menu Background="{DynamicResource BgBrush}"
            Foreground="{DynamicResource TextBrush}" FontSize="13" Padding="4,2">
        <MenuItem Header="_File">
          <MenuItem Command="Open" Header="Open _File" InputGestureText="Ctrl+O"/>
          <MenuItem Command="{x:Static local:MainWindow.OpenPlaylistCommand}" Header="Open _Playlist"
                    InputGestureText="Ctrl+Shift+O"/>
          <MenuItem Command="Save" InputGestureText="Ctrl+S"/>
          <MenuItem Command="SaveAs"/>
          <Separator/>
          <MenuItem Header="_Edit Preferences" Click="FilePreferences_Click"/>
          <Separator/>
          <MenuItem Header="E_xit" Click="FileExit_Click"/>
        </MenuItem>
        <MenuItem Header="_Edit">
          <MenuItem Command="Undo" InputGestureText="Ctrl+Z"/>
          <MenuItem Command="Redo" InputGestureText="Ctrl+Y"/>
          <Separator/>
          <MenuItem Command="Cut" InputGestureText="Ctrl+X"/>
          <MenuItem Command="Copy" InputGestureText="Ctrl+C"/>
          <MenuItem Command="Paste" InputGestureText="Ctrl+V"/>
          <Separator/>
          <MenuItem Command="Find" InputGestureText="Ctrl+F"/>
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem x:Name="FullScreenItem" Command="{x:Static local:MainWindow.FullScreenCommand}"
                    IsCheckable="True" InputGestureText="F11"/>
          <MenuItem Header="_Appearance">
            <MenuItem x:Name="ThemeLightItem" Header="_Light Mode" IsCheckable="True"
                      Click="ThemeLight_Click"/>
            <MenuItem x:Name="ThemeDarkItem" Header="_Dark Mode" IsCheckable="True"
                      Click="ThemeDark_Click"/>
            <MenuItem x:Name="ThemeSystemItem" Header="_System Settings" IsCheckable="True"
                      Click="ThemeSystem_Click"/>
          </MenuItem>
          <Separator/>
          <MenuItem Command="{x:Static local:MainWindow.OpenDocumentationCommand}"
                    Header="_Documentation"/>
          <Separator/>
          <MenuItem Command="{x:Static NavigationCommands.IncreaseZoom}" Header="Zoom _In"
                    InputGestureText="Ctrl+="/>
          <MenuItem Command="{x:Static NavigationCommands.DecreaseZoom}" Header="Zoom _Out"
                    InputGestureText="Ctrl+-"/>
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="_About" Click="HelpAbout_Click"/>
          <MenuItem Header="_What's New" Click="HelpWhatsNew_Click"/>
          <MenuItem Header="Check for U_pdates" Click="HelpCheckUpdates_Click"/>
        </MenuItem>
      </Menu>

      <!-- Deck finder: hidden until Edit → Find (Ctrl+F) reveals it. -->
      <StackPanel x:Name="FindBar" Grid.Column="1" Orientation="Horizontal"
                  VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
        <TextBlock Text="Find" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="SearchBox" Style="{StaticResource TbTextBox}" Width="180"
                 Height="26" Margin="0,3,0,3" Padding="8,2"
                 TextChanged="SearchBox_TextChanged"/>
      </StackPanel>
    </Grid>

    <!-- Top bar -->
    <controls:TopBarControl x:Name="TopBar" Grid.Row="1"/>

    <!-- Deck area -->
    <Grid Grid.Row="2">
      <ScrollViewer x:Name="ScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <controls:TileGridPanel x:Name="DeckPanel" Margin="18"/>
      </ScrollViewer>

      <!-- Empty state -->
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Visibility="Collapsed">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="No decks yet" HorizontalAlignment="Center"/>
        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Text="Add a deck, then import audio from your library to start mixing."/>
        <Button Style="{StaticResource TbPrimaryButton}" Content="Add 4 Decks"
                HorizontalAlignment="Center" Margin="0,16,0,0" Click="AddFour_Click"/>
      </StackPanel>

      <!-- Clear all decks (bottom-right overlay) -->
      <Button x:Name="ClearDecksButton" Style="{StaticResource TbClearDecks}" Content="Clear all decks"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
              Click="ClearAll_Click"/>

      <!-- Drawers -->
      <controls:MediaLibraryDrawer x:Name="LibraryDrawer" HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch" Visibility="Collapsed"/>
    </Grid>

    <!-- Update bubble + dialog (window-wide overlays; later = on top, so the
         update dialog paints over everything) -->
    <controls:UpdateBubbleControl x:Name="UpdateBubble" Grid.RowSpan="3"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    <controls:UpdateDialogControl x:Name="UpdateDialog" Grid.RowSpan="3" Visibility="Collapsed"/>

    <!-- Tile reorder drag layer (hosts the ghost; ignores mouse) -->
    <Canvas x:Name="DragLayer" Grid.RowSpan="3" Panel.ZIndex="1000" IsHitTestVisible="False"/>
  </Grid>
</Window>